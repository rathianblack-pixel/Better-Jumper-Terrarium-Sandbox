{
  "name": "Jumper Terrarium",
  "short_name": "Jumper",
  "description": "A calm jumping-spider terrarium in HD-2D and Storybook.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "any",
